p to post":["\u0417\u0456\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0456\u0437 \u0437\u0430\u043f\u0438\u0441\u043e\u043c"],"Please select a destination post before pulling comments.":["\u041f\u0435\u0440\u0435\u0434 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f\u043c \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0446\u0456\u043b\u044c\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441."],"Select at least one menu item and assign its destination object where required.":["\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 \u043e\u0434\u0438\u043d \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u043c\u0435\u043d\u044e \u0456, \u0434\u0435 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e, \u0432\u043a\u0430\u0436\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u043e\u0431'\u0454\u043a\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f."],"Please select one or more remote items.":["\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043e\u0434\u0438\u043d \u0430\u0431\u043e \u043a\u0456\u043b\u044c\u043a\u0430 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456\u0432 \u0432\u0456\u0434\u0434\u0430\u043b\u0435\u043d\u043e\u0433\u043e \u0441\u0430\u0439\u0442\u0443."],"Map remote comment posts to destination posts, then click Pull selected comments again.":["\u0417\u0456\u0441\u0442\u0430\u0432\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432 \u0432\u0456\u0434\u0434\u0430\u043b\u0435\u043d\u043e\u0433\u043e \u0441\u0430\u0439\u0442\u0443 \u0437 \u0446\u0456\u043b\u044c\u043e\u0432\u0438\u043c\u0438 \u0437\u0430\u043f\u0438\u0441\u0430\u043c\u0438, \u043f\u043e\u0442\u0456\u043c \u0437\u043d\u043e\u0432\u0443 \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u00ab\u041e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0432\u0438\u0431\u0440\u0430\u043d\u0456 \u043