msgstr "Неприпустимий контекст виконання завдання."

#: app/Abilities/Execution_Context.php:98
msgid "The job site is unavailable."
msgstr "Сайт завдання недоступний."

#: app/Abilities/Migration_Plan.php:135
msgid "Custom database tables are not supported by Content Migration."
msgstr "Міграція контенту не підтримує довільні таблиці бази даних."

#: app/Abilities/Migration_Plan.php:139
msgid "Unexpected migration table target."
msgstr "Неочікувана цільова таблиця міграції."

