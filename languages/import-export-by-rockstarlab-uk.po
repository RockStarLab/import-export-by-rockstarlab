#. Plugin Name of the plugin
#: import-export-by-rockstarlab.php
#: app/Controller/Abilities_Controller.php:108
#: app/Controller/Init.php:1910
#: app/View/settings/welcome.php:18
msgid "Content Sync, Media Sync, Import, Export with AI Agents Support"
msgstr "Content Sync, Media Sync, Import, Export with AI Agents Support"

#. Plugin URI of the plugin
#: import-export-by-rockstarlab.php
msgid "https://profiles.wordpress.org/rockstarlab/"
msgstr "https://profiles.wordpress.org/rockstarlab/"

#. Description of the plugin
#: import-export-by-rockstarlab.php
msgid "Import, export, and sync WordPress content between sites with CSV, XML, XLSX, ODS, JSON, jobs, media tools, and AI URL import."
msgstr "Імпорт, експорт і синхронізація контенту WordPress між сайтами: CSV, XML, XLSX, ODS, JSON, завдання, інструменти для медіафайлів та імпорт за URL за допомогою ШІ."

#. Author of the plugin
#: import-export-by-rockstarlab.php
msgid "RockstarLab"
msgstr "RockstarLab"

#. Author URI of the plugin
#: import-export-by-rockstarlab.php
msgid "https://profiles.wordpress.org/rockstarlab/profile/"
msgstr "https://profiles.wordpress.org/rockstarlab/profile/"

#: app/Abilities/Access_Policy.php:31
msgid "Invalid field transformation."
msgstr "Неприпустиме перетворення поля."

