#!/bin/sh

# Detect OS for platform-specific paths
OS="$(uname -s 2>/dev/null || echo Unknown)"
case "$OS" in
Linux*) PLATFORM=linux ;;
Darwin*) PLATFORM=macos ;;
MINGW* | MSYS* | CYGWIN*) PLATFORM=windows ;;
*) PLATFORM=unknown ;;
esac

echo "🖥️ Detected platform: $PLATFORM"

# Add NVM path if available
if [ -d "$HOME/.nvm" ]; then
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
fi

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

echo "📊 Environment diagnostics:"
echo "Current location: $(pwd)"

# Check PHP
if command_exists php; then
    echo "✅ Found PHP: $(which php) ($(php --version | head -n 1))"
else
    echo "❌ PHP not found in PATH"
fi

# Check Node.js
if command_exists node; then
    echo "✅ Found Node.js: $(which node) ($(node --version))"
else
    echo "❌ Node.js not found in PATH"
fi

# Check npm/npx
if command_exists npx; then
    echo "✅ Found npx: $(which npx)"
else
    echo "❌ npx not found in PATH"
fi

# ==========================================
# PHP CODE STYLE CHECK (PHPCS/PHPCBF)
# ==========================================

SKIP_PHPCBF=${SKIP_PHPCBF:-0}

if command_exists php && [ "$SKIP_PHPCBF" -eq 0 ]; then
    STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "\.php$" || true)
    
    if [ -n "$STAGED_PHP_FILES" ]; then
        echo ""
        echo "🔍 Checking PHP files..."
        
        if [ -f "./vendor/bin/phpcbf" ] && [ -f "./vendor/bin/phpcs" ]; then
            # Auto-fix with PHPCBF
            echo "🔧 Running PHPCBF (auto-fix)..."
            echo "$STAGED_PHP_FILES" | xargs ./vendor/bin/phpcbf --standard=.phpcs.xml.dist || true
            
            # Re-stage fixed files
            echo "$STAGED_PHP_FILES" | xargs git add
            
            # Check with PHPCS (informational only)
            echo "📋 Running PHPCS (check)..."
            echo "$STAGED_PHP_FILES" | xargs ./vendor/bin/phpcs --standard=.phpcs.xml.dist --report=summary || true
            
            echo "✅ PHP check completed"
        else
            echo "⚠️ PHPCS/PHPCBF not found in vendor/bin, skipping PHP checks"
            echo "💡 Run: composer install"
        fi
    fi
elif [ "$SKIP_PHPCBF" -eq 1 ]; then
    echo "⏭️ Skipping PHP checks (SKIP_PHPCBF=1)"
fi

# ==========================================
# JS/CSS/SCSS FORMATTING (Prettier)
# ==========================================

if command_exists npx; then
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "\.(js|scss|css|md)$" || true)
    
    if [ -n "$STAGED_FILES" ]; then
        echo ""
        echo "🎨 Running Prettier on staged files:"
        
        # Format each file individually to avoid one error blocking all
        for file in $STAGED_FILES; do
            echo "  - $file"
            if npx prettier --write "$file" 2>/dev/null; then
                git add "$file"
            else
                echo "    ⚠️ Could not format $file (syntax error?)"
            fi
        done
        
        echo "✅ Formatting completed"
    else
        echo ""
        echo "ℹ️ No JS/CSS/SCSS files to format"
    fi
else
    echo "⚠️ npx not available, skipping JS/CSS formatting"
fi

echo ""
echo "✅ Pre-commit checks completed"
exit 0
