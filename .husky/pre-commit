#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Detect OS for platform-specific paths
OS="$(uname -s 2>/dev/null || echo Unknown)"
case "$OS" in
Linux*) PLATFORM=linux ;;
Darwin*) PLATFORM=macos ;;
MINGW* | MSYS* | CYGWIN*) PLATFORM=windows ;;
*) PLATFORM=unknown ;;
esac

echo "🖥️ Detected platform: $PLATFORM"

# Add platform-specific paths
if [ "$PLATFORM" = "windows" ]; then
    # Windows Git Bash paths
    export PATH="/c/Windows/system32:/c/Windows:/c/Program Files/nodejs:/c/Program Files/Git/cmd:/c/Program Files/php:$PATH"
    # Check for PHP in common Windows locations
    for PHP_PATH in "/c/php" "/c/xampp/php" "/c/wamp/bin/php"/*; do
        if [ -d "$PHP_PATH" ]; then
            export PATH="$PHP_PATH:$PATH"
        fi
    done
elif [ "$PLATFORM" = "linux" ]; then
    # Add Linux-specific paths
    export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/snap/bin:/var/lib/snapd/snap/bin:$PATH"
    # Check for Node.js in common locations
    for NODE_PATH in "/usr/local/nodejs/bin" "/opt/nodejs/bin" "$HOME/.nvm/versions/node/*/bin"; do
        if [ -d "$NODE_PATH" ]; then
            export PATH="$NODE_PATH:$PATH"
        fi
    done
    # Check for PHP versions
    for PHP_PATH in /usr/bin/php*; do
        if [ -f "$PHP_PATH" ]; then
            export PATH="$(dirname $PHP_PATH):$PATH"
        fi
    done
else
    # macOS common paths
    export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/opt/php/bin:/usr/local/php/bin:$PATH"
    # Add Homebrew PHP paths for Apple Silicon and Intel Macs
    export PATH="/opt/homebrew/opt/php/bin:/usr/local/opt/php/bin:$PATH"
    # Add Node/NPM paths
    export PATH="/opt/homebrew/opt/node/bin:/usr/local/opt/node/bin:$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node/ 2>/dev/null | sort -V | tail -n1)/bin:$PATH"
    # Add Yarn paths
    export PATH="/opt/homebrew/opt/yarn/bin:/usr/local/opt/yarn/bin:$HOME/.yarn/bin:$PATH"
fi

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to check Node.js version
check_node_version() {
    if command_exists node; then
        NODE_VERSION=$(node --version | sed 's/v//')
        MAJOR_VERSION=$(echo $NODE_VERSION | cut -d. -f1)
        echo "✅ Found Node.js: $(which node) (v$NODE_VERSION)"
        if [ "$MAJOR_VERSION" -lt 14 ]; then
            echo "❌ Node.js version $NODE_VERSION is too old (minimum required: 14)"
            return 1
        else
            return 0
        fi
    else
        echo "❌ Node.js not found in PATH"
        return 1
    fi
}

# Function to check if a local package exists
package_exists() {
    if [ -f "./node_modules/.bin/$1" ]; then
        return 0
    else
        return 1
    fi
}

# Function to check if a PHP tool exists
php_tool_exists() {
    if [ -f "./vendor/bin/$1" ]; then
        return 0
    else
        return 1
    fi
}

# Print diagnostics for debugging
echo "📊 Environment diagnostics:"
echo "PATH=$PATH"
echo "Current location: $(pwd)"

if command_exists php; then
    echo "✅ Found PHP: $(which php) ($(php --version | head -n 1))"
else
    echo "❌ PHP not found in PATH"
fi

# Check Node.js version
NODE_VERSION_OK=0
if check_node_version; then
    NODE_VERSION_OK=1
    # Additional Node.js diagnostics
    echo "📋 Node.js diagnostics:"
    echo "  Node path: $(which node)"
    echo "  NPM path: $(which npm 2>/dev/null || echo 'not found')"
    echo "  NPM version: $(npm --version 2>/dev/null || echo 'not available')"
else
    echo "💡 Try installing/updating Node.js with:"
    echo "   curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash - && sudo apt-get install -y nodejs"
fi

if command_exists yarn; then
    echo "✅ Found Yarn: $(which yarn) ($(yarn --version))"
else
    echo "❌ Yarn not found in PATH"
fi

# Set SKIP_PHPCBF=1 to skip PHP checks (for quick/temporary commits)
# usage: SKIP_PHPCBF=1 git commit -m "..."
SKIP_PHPCBF=${SKIP_PHPCBF:-0}

# First check if PHP is available
if ! command_exists php; then
    echo "⚠️ PHP command not found, please ensure PHP is installed and in your PATH"
    echo "⚠️ Skipping PHP checks due to missing PHP command"
    if [ "$PLATFORM" = "linux" ]; then
        echo "💡 Try installing PHP with: sudo apt-get install php-cli"
    else
        echo "💡 Try installing PHP with: brew install php"
    fi
else
    # Check PHP files
    STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "^.*\.(php)$" || true)

    if [ ! -z "$STAGED_PHP_FILES" ] && [ "$SKIP_PHPCBF" -eq 0 ]; then
        echo "Checking PHP files..."
        echo "$STAGED_PHP_FILES"

        if php_tool_exists "phpcs" && php_tool_exists "phpcbf"; then
            # First, try to fix automatically
            echo "🔧 Running PHPCBF for automatic fixing..."
            echo "$STAGED_PHP_FILES" | xargs ./vendor/bin/phpcbf --standard=.phpcs.xml.dist || true

            # Add fixed files to the index
            echo "$STAGED_PHP_FILES" | xargs git add

            # Run PHPCS for checking, but explicitly ignore the return code
            echo "🔍 Checking remaining issues with PHPCS (informative)..."
            echo "$STAGED_PHP_FILES" | xargs ./vendor/bin/phpcs --standard=.phpcs.xml.dist --report=summary -q || true

            echo "✅ PHP check completed. Some errors may have been automatically fixed."
            echo "⚠️ If there are remaining errors, you can fix them manually or use SKIP_PHPCBF=1 before committing to skip the check."
        else
            echo "⚠️ PHPCS/PHPCBF not found, skipping PHP checks"
        fi
    elif [ "$SKIP_PHPCBF" -eq 1 ]; then
        echo "⏭️ Skipping PHP file checks (SKIP_PHPCBF=1)"
    fi
fi

# Skip the Node.js step if node version is not OK
if [ "$NODE_VERSION_OK" -eq 0 ]; then
    echo "⚠️ Node.js not available or version too old, skipping JS/CSS checks"
    exit 0
else
    # Load additional paths from .huskyrc.js if it exists
    if [ -f ".huskyrc.js" ]; then
        echo "Loading additional paths from .huskyrc.js"
        ADDITIONAL_PATHS=$(node -e "try { const paths = require('./.huskyrc.js').getSystemPaths(); console.log(paths.join(':'));} catch(e) {console.error('Error loading .huskyrc.js:', e.message);}")
        if [ ! -z "$ADDITIONAL_PATHS" ] && [ "$ADDITIONAL_PATHS" != "undefined" ]; then
            export PATH="$PATH:$ADDITIONAL_PATHS"
            echo "✅ Added paths from .huskyrc.js"
        else
            echo "❌ Failed to get paths from .huskyrc.js"
        fi
    fi
fi

# Check for yarn
if ! command_exists yarn; then
    echo "⚠️ Yarn not found, skipping JS/CSS checks"
    echo "💡 Try installing Yarn with: npm install -g yarn"
    exit 0
fi

# Check ESLint version for diagnostics
if package_exists "eslint"; then
    ESLINT_VERSION=$(./node_modules/.bin/eslint --version 2>/dev/null || echo "unknown")
    echo "📋 ESLint version: $ESLINT_VERSION"
fi

# Check for linters before running lint-staged
if ! package_exists "eslint"; then
    echo "⚠️ ESLint not found, some checks will be skipped"
fi

if ! package_exists "stylelint"; then
    echo "⚠️ StyleLint not found, some checks will be skipped"
fi

if ! package_exists "prettier"; then
    echo "⚠️ Prettier not found, some checks will be skipped"
fi

# If at least one tool is available, run lint-staged
if package_exists "eslint" || package_exists "stylelint" || package_exists "prettier"; then
    echo "🔍 Running JS/CSS/other file checks..."

    # Handle JavaScript files
    STAGED_JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "^src/.*\.js$" || true)
    if [ ! -z "$STAGED_JS_FILES" ]; then
        echo "Checking JavaScript files..."
        echo "$STAGED_JS_FILES"
        
        if package_exists "eslint"; then
            echo "🔧 Running ESLint..."
            # Use the Node.js from PATH explicitly
            if NODE_OPTIONS="--no-warnings" node ./node_modules/.bin/eslint --fix $STAGED_JS_FILES 2>/dev/null; then
                echo "✅ ESLint passed"
            else
                echo "⚠️ ESLint failed, falling back to prettier..."
                if package_exists "prettier"; then
                    echo "$STAGED_JS_FILES" | xargs ./node_modules/.bin/prettier --write 2>/dev/null || echo "❌ Prettier also failed"
                else
                    echo "❌ Prettier not available"
                fi
            fi
        elif package_exists "prettier"; then
            echo "🔧 Running prettier on JS files..."
            echo "$STAGED_JS_FILES" | xargs ./node_modules/.bin/prettier --write 2>/dev/null || echo "❌ Prettier failed"
        fi
        # Stage fixed files
        echo "$STAGED_JS_FILES" | xargs git add
    fi

    # Handle CSS/SCSS files
    STAGED_STYLE_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "^src/.*\.(scss|css)$" || true)
    if [ ! -z "$STAGED_STYLE_FILES" ]; then
        echo "Checking style files..."
        echo "$STAGED_STYLE_FILES"
        
        if package_exists "stylelint"; then
            echo "🔧 Running Stylelint..."
            if ./node_modules/.bin/stylelint $STAGED_STYLE_FILES --fix 2>/dev/null; then
                echo "✅ Stylelint passed"
            else
                echo "⚠️ Stylelint failed, falling back to prettier..."
                if package_exists "prettier"; then
                    echo "$STAGED_STYLE_FILES" | xargs ./node_modules/.bin/prettier --write 2>/dev/null || echo "❌ Prettier also failed"
                else
                    echo "❌ Prettier not available"
                fi
            fi
        elif package_exists "prettier"; then
            echo "🔧 Running prettier on style files..."
            echo "$STAGED_STYLE_FILES" | xargs ./node_modules/.bin/prettier --write 2>/dev/null || echo "❌ Prettier failed"
        fi
        # Stage fixed files
        echo "$STAGED_STYLE_FILES" | xargs git add
    fi

    echo "✅ JS/CSS/other file checks completed."
else
    echo "⚠️ No linting tools found, skipping all checks"
fi

# Always exit with a successful code
exit 0